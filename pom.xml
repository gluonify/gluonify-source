<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- STANDALONE project: no Gluonify parent POM, nothing to install first. Rename groupId/artifactId (see README, "Rename the project"). -->
  <groupId>io.gluonify.source</groupId>
  <artifactId>gluonify-source</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>gluonify-source (example application for Gluonify)</name>
  <description>Starter Quarkus 4 service: REST, Quinoa UI, Charm authentication, data (distributed files or Gdown), Photon webhooks, PDF documents (Crystallon).</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <!-- Native toolchain (gluonify-plasma README, "Native toolchain"): the G1 heap policy of the Oracle GraalVM builds on amd64, and the optional parts of the
         native-image option list (each one carries its own leading comma, so the list never has an empty element): -Dgluonify.native.x86-level=v2|v3 fills
         the first (profile gluonify-native-x86), a build script may set the second (-Dgluonify.native.extra.list=,<comma-separated options>). The empty default of
         the second comes from the profile gluonify-native-extra-default, active only when the property is absent: the build scripts pass it in MAVEN_OPTS, a
         JVM system property, which a property of the pom would override (Maven resolves pom properties before system properties; PGO trial on atom, 2026-11-08). -->
    <!-- 10 % of the RAM, not GraalVM's 25 % (decision of the user, 2026-11-05: the periodic collection gives the grown heap back to nobody, lab measurement; the cap is the only bound) -->
    <gluonify.native.g1.max-ram-percentage>10</gluonify.native.g1.max-ram-percentage>
    <gluonify.native.g1.periodic-gc-interval>15000</gluonify.native.g1.periodic-gc-interval>
    <gluonify.native.march.list></gluonify.native.march.list>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>4.0.0.Beta3</quarkus.platform.version>
    <quinoa.version>2.9.2</quinoa.version>
    <surefire.version>3.5.2</surefire.version>
    <!-- Gluonify SDK. The version is the platform's (the "Code" tab of Crystallon's editor shows the one of your installation).
         gluonify-plasma-quarkus and gluonify-plasma-testing are not in a published release yet (0.6.0 has the Crystallon client only): until the next one, install the
         SDK sources with "mvn install" in gluonify-plasma (0.3.0-SNAPSHOT), then set this to the release number. -->
    <gluonify.sdk.version>0.7.2</gluonify.sdk.version>
    <!-- Maven repository of the Gluonify SDK, served by gluonify-sea (public read, nothing to configure but this declaration).
         A property so that a mirror or a local copy can replace it: mvn verify -Dgluonify.sea.maven.url=file:///path/to/repository -->
    <gluonify.sea.maven.url>https://images.gluonify.io/maven</gluonify.sea.maven.url>
    <!-- Quality gates of every build (copy of the gluonify-plasma parent POM, README "Quality gates": keep identical): versions, and the ratchets each repository sets to its current level. -->
    <jacoco.version>0.8.14</jacoco.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.28.0</pmd.version>
    <!-- Version of gluonify-plasma-build-rules (the PMD ruleset, installed by gluonify-plasma's mvn install): kept equal to gluonify-plasma's version. -->
    <gluonify.build-rules.version>0.3.0-SNAPSHOT</gluonify.build-rules.version>
    <!-- Coverage ratchet (JaCoCo, whole module): each repository sets its current level rounded down, raises it with its tests, never lowers it. -->
    <gluonify.coverage.minimum>1.00</gluonify.coverage.minimum>
    <gluonify.coverage.branch.minimum>1.00</gluonify.coverage.branch.minimum>
    <!-- Existing PMD debt only (class=Rule,Rule): a line is removed when its class is fixed, never added. -->
    <gluonify.pmd.baseline>${project.basedir}/pmd-baseline.properties</gluonify.pmd.baseline>
  </properties>

  <repositories>
    <!-- Added to Maven Central, not instead of it. Gluonify's builder (Bup) declares this same repository itself for the builds it runs. -->
    <repository>
      <id>gluonify-sea</id>
      <url>${gluonify.sea.maven.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- REST + JSON (Jackson 3) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Request body validation (@NotBlank, @Size...) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <!-- Health: REQUIRED by Gluonify (builder rule R-SANTE): traffic only arrives if /q/health/ready answers 200 -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- Authentication: gluonify-charm tokens (OpenID Connect, "service" mode) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <!-- OpenAPI contract (/q/openapi) and Swagger UI (/q/swagger-ui) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <!-- Prometheus metrics (/q/metrics): the platform scrapes them -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Web UI: Quinoa builds and serves the Vue project in src/main/webui -->
    <dependency>
      <groupId>io.quarkiverse.quinoa</groupId>
      <artifactId>quarkus-quinoa</artifactId>
      <version>${quinoa.version}</version>
    </dependency>
    <!-- Gluonify SDK, zero configuration: default CDI beans for the services (CrystallonClient, with the address and the token found by the SDK: platform, "gluonify login", fake services in tests);
         brings gluonify-plasma-services and gluonify-plasma-crystallon-client. Crystallon stays optional at run time: see io.gluonify.source.documents -->
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-quarkus</artifactId>
      <version>${gluonify.sdk.version}</version>
    </dependency>

    <!-- Fake Gluonify services for tests (GluonifyTestServices.start() / close()): a fake Crystallon, nothing to configure -->
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-testing</artifactId>
      <version>${gluonify.sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd.plugin.version}</version>
          <configuration>
            <rulesets>
              <ruleset>gluonify/pmd/ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${maven.compiler.release}</targetJdk>
            <includeTests>false</includeTests>
            <failurePriority>5</failurePriority>
            <printFailingErrors>true</printFailingErrors>
            <excludeFromFailureFile>${gluonify.pmd.baseline}</excludeFromFailureFile>
            <linkXRef>false</linkXRef>
            <analysisCache>true</analysisCache>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-javascript</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-jsp</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>io.gluonify.plasma</groupId>
              <artifactId>gluonify-plasma-build-rules</artifactId>
              <version>${gluonify.build-rules.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- Tests never depend on the machine: no cluster known (an empty folder instead of ~/.gluonify), so Crystallon is available only when a test starts the fake services -->
            <GLUONIFY_HOME>${project.build.directory}/gluonify-home</GLUONIFY_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Quality gates (copy of the gluonify-plasma parent POM, README "Quality gates"): active in every module that has Java sources, so that the parent POMs and the build-rules module
         (no code) neither need the ruleset nor measure anything. `mvn verify` fails like a red test when the coverage falls below the ratchet or
         when PMD finds a violation that is not in the module's pmd-baseline.properties. -Djacoco.skip / -Dpmd.skip for a scoped run. -->
    <profile>
      <id>gluonify-quality</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>gluonify-coverage-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
              <execution>
                <id>gluonify-coverage-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.minimum}</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.branch.minimum}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-pmd-check</id>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- activated by -Dnative (what gluonify-bup does: mvn package -Dnative) -->
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <!-- -march=compatibility : the executable runs on any x86-64 / arm64 CPU (otherwise GraalVM 25 targets x86-64-v3, AVX2).
             SystemTicker : Netty must not freeze the build machine's clock at compile time, otherwise its timeouts expire immediately elsewhere. -->
        <quarkus.native.additional-build-args>-march=compatibility,--initialize-at-run-time=io.netty.util.concurrent.SystemTicker</quarkus.native.additional-build-args>
      </properties>
    </profile>
    <!-- Native toolchain (decision of the user, 2026-11-05: two build profiles on every artifact; gluonify-codex/plan.md, "Native toolchain"). Each component's
         Dockerfile.build passes -Dgluonify.native.toolchain=oracle|mandrel (its NATIVE_TOOLCHAIN argument): the matching profile appends the collector to the
         component's own quarkus.native.additional-build-args (the last -march wins, like the x86-64 level). Oracle GraalVM 25 uses G1 on Linux x86_64 only,
         with an explicit heap policy; Mandrel 25 has only the serial collector. Without the property nothing is appended: a developer's `mvn -Pnative package`
         (Liberica NIK, GraalVM CE) and the customers' applications built by Bup are unchanged. The conditions of one activation are all required (Maven 3.2.2+). -->
    <profile>
      <!-- empty extra native-image options unless a build script passes -Dgluonify.native.extra.list (see the properties above) -->
      <id>gluonify-native-extra-default</id>
      <activation>
        <property>
          <name>!gluonify.native.extra.list</name>
        </property>
      </activation>
      <properties>
        <gluonify.native.extra.list></gluonify.native.extra.list>
      </properties>
    </profile>
    <profile>
      <!-- Oracle GraalVM on Linux x86_64: the G1 collector and its heap policy (gluonify.native.g1.*) -->
      <id>gluonify-native-oracle</id>
      <activation>
        <property>
          <name>gluonify.native.toolchain</name>
          <value>oracle</value>
        </property>
        <os>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <quarkus.native.additional-build-args-append>--gc=G1,-R:MaxRAMPercentage=${gluonify.native.g1.max-ram-percentage},-R:G1PeriodicGCInterval=${gluonify.native.g1.periodic-gc-interval}${gluonify.native.march.list}${gluonify.native.extra.list}</quarkus.native.additional-build-args-append>
      </properties>
    </profile>
    <profile>
      <!-- Oracle GraalVM on arm64: G1 is Linux x86_64 only -->
      <id>gluonify-native-oracle-arm64</id>
      <activation>
        <property>
          <name>gluonify.native.toolchain</name>
          <value>oracle</value>
        </property>
        <os>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <quarkus.native.additional-build-args-append>--gc=serial${gluonify.native.march.list}${gluonify.native.extra.list}</quarkus.native.additional-build-args-append>
      </properties>
    </profile>
    <profile>
      <!-- Mandrel: the serial collector, its only one -->
      <id>gluonify-native-mandrel</id>
      <activation>
        <property>
          <name>gluonify.native.toolchain</name>
          <value>mandrel</value>
        </property>
      </activation>
      <properties>
        <quarkus.native.additional-build-args-append>--gc=serial${gluonify.native.march.list}${gluonify.native.extra.list}</quarkus.native.additional-build-args-append>
      </properties>
    </profile>
    <profile>
      <!-- amd64 natives: -march=x86-64-<level> after the pom's -march=compatibility (the last one wins), plus AES-NI and PCLMULQDQ, which no x86-64 level
           includes: without them the JDK's TLS runs AES-GCM in plain Java (3x slower, ingress bench of 2026-10-29); the start-up check and Strange's X86Level
           require them at v2 (the comma of the CPU features is escaped for Quarkus's list). -->
      <id>gluonify-native-x86</id>
      <activation>
        <property>
          <name>gluonify.native.x86-level</name>
        </property>
      </activation>
      <properties>
        <gluonify.native.march.list>,-march=x86-64-${gluonify.native.x86-level},-H:+UnlockExperimentalVMOptions,-H:CPUFeatures=AES\,CLMUL,-H:-UnlockExperimentalVMOptions</gluonify.native.march.list>
      </properties>
    </profile>
  </profiles>
</project>
