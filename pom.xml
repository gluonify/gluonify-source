<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- STANDALONE project: no Gluonify parent POM, nothing to install first. Rename groupId/artifactId (see README, "Rename the project"). -->
  <groupId>io.gluonify.source</groupId>
  <artifactId>gluonify-source</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>gluonify-source (example application for Gluonify)</name>
  <description>Starter Quarkus 4 service: REST, Quinoa UI, Charm authentication, data (distributed files or Gdown), Photon webhooks, PDF documents (Crystallon).</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>4.0.0.Beta1</quarkus.platform.version>
    <quinoa.version>2.9.2</quinoa.version>
    <surefire.version>3.5.2</surefire.version>
    <!-- Gluonify SDK. The version is the platform's (the "Code" tab of Crystallon's editor shows the one of your installation).
         gluonify-plasma-quarkus and gluonify-plasma-testing are not in a published release yet (0.6.0 has the Crystallon client only): until the next one, install the
         SDK sources with "mvn install" in gluonify-plasma (0.1.0), then set this to the release number. -->
    <gluonify.sdk.version>0.7.2</gluonify.sdk.version>
    <!-- Maven repository of the Gluonify SDK, served by gluonify-sea (public read, nothing to configure but this declaration).
         A property so that a mirror or a local copy can replace it: mvn verify -Dgluonify.sea.maven.url=file:///path/to/repository -->
    <gluonify.sea.maven.url>https://images.gluonify.io/maven</gluonify.sea.maven.url>
    <!-- Quality gates of every build (copy of the gluonify-plasma parent POM, README "Quality gates": keep identical): versions, and the ratchets each repository sets to its current level. -->
    <jacoco.version>0.8.14</jacoco.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.28.0</pmd.version>
    <!-- Version of gluonify-plasma-build-rules (the PMD ruleset, installed by gluonify-plasma's mvn install): kept equal to gluonify-plasma's version. -->
    <gluonify.build-rules.version>0.1.0</gluonify.build-rules.version>
    <!-- Coverage ratchet (JaCoCo, whole module): each repository sets its current level rounded down, raises it with its tests, never lowers it. -->
    <gluonify.coverage.minimum>1.00</gluonify.coverage.minimum>
    <gluonify.coverage.branch.minimum>1.00</gluonify.coverage.branch.minimum>
    <!-- Existing PMD debt only (class=Rule,Rule): a line is removed when its class is fixed, never added. -->
    <gluonify.pmd.baseline>${project.basedir}/pmd-baseline.properties</gluonify.pmd.baseline>
  </properties>

  <repositories>
    <!-- Added to Maven Central, not instead of it. Gluonify's builder (Bup) declares this same repository itself for the builds it runs. -->
    <repository>
      <id>gluonify-sea</id>
      <url>${gluonify.sea.maven.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- Before the Quarkus BOM, so that it wins (as in the gluonify-plasma parent, which this standalone project does not inherit): Quarkus 4.0.0.Beta1
             brings Jackson 3.1.4, with high advisories fixed in 3.1.6 and 3.1.7 (sbom.py audit, 2026-10-24). Remove once the Quarkus BOM is at 3.1.7 or later. -->
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>3.1.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- REST + JSON (Jackson 3) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Request body validation (@NotBlank, @Size...) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <!-- Health: REQUIRED by Gluonify (builder rule R-SANTE): traffic only arrives if /q/health/ready answers 200 -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- Authentication: gluonify-charm tokens (OpenID Connect, "service" mode) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <!-- OpenAPI contract (/q/openapi) and Swagger UI (/q/swagger-ui) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <!-- Prometheus metrics (/q/metrics): the platform scrapes them -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Web UI: Quinoa builds and serves the Vue project in src/main/webui -->
    <dependency>
      <groupId>io.quarkiverse.quinoa</groupId>
      <artifactId>quarkus-quinoa</artifactId>
      <version>${quinoa.version}</version>
    </dependency>
    <!-- Gluonify SDK, zero configuration: default CDI beans for the services (CrystallonClient, with the address and the token found by the SDK: platform, "gluonify login", fake services in tests);
         brings gluonify-plasma-services and gluonify-plasma-crystallon-client. Crystallon stays optional at run time: see io.gluonify.source.documents -->
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-quarkus</artifactId>
      <version>${gluonify.sdk.version}</version>
    </dependency>

    <!-- Fake Gluonify services for tests (GluonifyTestServices.start() / close()): a fake Crystallon, nothing to configure -->
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-testing</artifactId>
      <version>${gluonify.sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd.plugin.version}</version>
          <configuration>
            <rulesets>
              <ruleset>gluonify/pmd/ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${maven.compiler.release}</targetJdk>
            <includeTests>false</includeTests>
            <failurePriority>5</failurePriority>
            <printFailingErrors>true</printFailingErrors>
            <excludeFromFailureFile>${gluonify.pmd.baseline}</excludeFromFailureFile>
            <linkXRef>false</linkXRef>
            <analysisCache>true</analysisCache>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-javascript</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-jsp</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>io.gluonify.plasma</groupId>
              <artifactId>gluonify-plasma-build-rules</artifactId>
              <version>${gluonify.build-rules.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- Tests never depend on the machine: no cluster known (an empty folder instead of ~/.gluonify), so Crystallon is available only when a test starts the fake services -->
            <GLUONIFY_HOME>${project.build.directory}/gluonify-home</GLUONIFY_HOME>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Quality gates (copy of the gluonify-plasma parent POM, README "Quality gates"): active in every module that has Java sources, so that the parent POMs and the build-rules module
         (no code) neither need the ruleset nor measure anything. `mvn verify` fails like a red test when the coverage falls below the ratchet or
         when PMD finds a violation that is not in the module's pmd-baseline.properties. -Djacoco.skip / -Dpmd.skip for a scoped run. -->
    <profile>
      <id>gluonify-quality</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>gluonify-coverage-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
              <execution>
                <id>gluonify-coverage-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.minimum}</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.branch.minimum}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-pmd-check</id>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- activated by -Dnative (what gluonify-bup does: mvn package -Dnative) -->
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <!-- -march=compatibility : the executable runs on any x86-64 / arm64 CPU (otherwise GraalVM 25 targets x86-64-v3, AVX2).
             SystemTicker : Netty must not freeze the build machine's clock at compile time, otherwise its timeouts expire immediately elsewhere. -->
        <quarkus.native.additional-build-args>-march=compatibility,--initialize-at-run-time=io.netty.util.concurrent.SystemTicker</quarkus.native.additional-build-args>
      </properties>
    </profile>
  </profiles>
</project>
