# glibc native executable of gluonify-source (architecture of the Docker host: arm64 on Apple Silicon, amd64 on an x86_64 server), dynamically linked against glibc 2.34 or later (Debian 12/13, Ubuntu 22.04+).
# This is what Gluonify runs: a single file, no JVM. Usage:
#   docker build --target out --output type=local,dest=dist -f Dockerfile.build .      ->  dist/gluonify-source
# STANDALONE project: no extra context (unlike Gluonify's internal components, which receive the parent POM of gluonify-plasma).
# The Vue UI (Quinoa) is built with the system Node (the one Quinoa would download is linked to glibc, not to this image) and embedded in the executable.
# Native toolchain: Mandrel 25 (Red Hat's JDK 25 + native-image, ubi9: glibc 2.34), pinned by digest; Maven and Node copied from their official images.
FROM maven:3.9.11-eclipse-temurin-25@sha256:407c4423cec0cf2981055bc2c6c0dc211d9605b6669279b95997f2d1c7e91e2c AS maven
FROM node:24.11.1-bookworm-slim@sha256:48abc13a19400ca3985071e287bd405a1d99306770eb81d61202fb6b65cf0b57 AS node
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25@sha256:c0c1c74529e053b272bd5dcb16c646a9dd7546c5c6e76f5c6141c0d72a9126e0 AS build
USER root
COPY --from=maven /usr/share/maven /opt/maven
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV PATH=/opt/maven/bin:$PATH
WORKDIR /src
COPY pom.xml .
COPY src src
# Cross build under emulation (qemu, e.g. x86_64 on Apple Silicon): jspawnhelper fails (code 127), processes must be launched with vfork:
#   --build-arg MAVEN_OPTS=-Djdk.lang.Process.launchMechanism=VFORK
ARG MAVEN_OPTS=
ENV MAVEN_OPTS=${MAVEN_OPTS}
RUN --mount=type=cache,target=/root/.m2 mvn -B -q -DskipTests -Pnative -Dquarkus.quinoa.package-manager-install=false -Dquarkus.quinoa.run-tests=false package
FROM scratch AS out
COPY --from=build /src/target/*-runner /gluonify-source
